# Production Backend API URL (Vercel Environment Variable)
# When deploying the frontend to Vercel, set this variable in:
# Vercel Dashboard -> Project Settings -> Environment Variables
# Example: https://legalmet-backend.onrender.com/api
# If left empty, it defaults to '/api' (proxied via Vite in dev or vercel.json rewrites)
VITE_API_BASE_URL=
